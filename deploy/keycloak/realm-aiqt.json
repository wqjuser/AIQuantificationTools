{
  "realm": "aiqt",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "passwordPolicy": "hashAlgorithm(argon2) and length(15) and notUsername and notEmail and passwordHistory(5)",
  "defaultDefaultClientScopes": [
    "basic"
  ],
  "defaultOptionalClientScopes": [
    "aiqt:research:read"
  ],
  "clients": [
    {
      "clientId": "admin-cli",
      "name": "Disabled built-in admin CLI",
      "enabled": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "aiqt-web",
      "name": "AI Quantification Tools Web",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${AIQT_KEYCLOAK_WEB_CLIENT_SECRET}",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "${AIQT_PUBLIC_ORIGIN}/api/auth/callback"
      ],
      "webOrigins": [
        "${AIQT_PUBLIC_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${AIQT_PUBLIC_ORIGIN}"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "aiqt-mcp",
      "name": "AI Quantification Tools MCP",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "fullScopeAllowed": false,
      "redirectUris": [
        "https://claude.ai/api/mcp/auth_callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [
        "aiqt:research:read"
      ]
    }
  ],
  "clientProfiles": {
    "profiles": [
      {
        "name": "claude-cimd-profile",
        "description": "Allow the official Claude public MCP clients with OAuth 2.1 controls",
        "executors": [
          {
            "executor": "client-id-metadata-document",
            "configuration": {
              "cimd-allow-http-scheme": false,
              "cimd-allow-permitted-domains": [
                "claude.ai",
                "localhost",
                "127.0.0.1"
              ],
              "cimd-restrict-same-domain": false,
              "cimd-required-properties": [
                "client_name",
                "redirect_uris",
                "grant_types",
                "response_types",
                "token_endpoint_auth_method"
              ],
              "only-allow-confidential-client": false
            }
          },
          {
            "executor": "pkce-enforcer",
            "configuration": {
              "auto-configure": "true"
            }
          },
          {
            "executor": "reject-implicit-grant",
            "configuration": {
              "auto-configure": "true"
            }
          },
          {
            "executor": "reject-ropc-grant",
            "configuration": {
              "auto-configure": "true"
            }
          },
          {
            "executor": "full-scope-disabled",
            "configuration": {
              "auto-configure": "true"
            }
          },
          {
            "executor": "consent-required",
            "configuration": {
              "auto-configure": "true"
            }
          }
        ]
      },
      {
        "name": "reject-non-public-cimd-profile",
        "description": "Reject Claude CIMD metadata that does not describe a public client",
        "executors": [
          {
            "executor": "reject-request",
            "configuration": {}
          }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "allow-official-claude-cimd",
        "description": "Fetch client metadata only from the official Claude HTTPS domain",
        "enabled": true,
        "mode": "STRICT",
        "conditions": [
          {
            "condition": "client-id-uri",
            "configuration": {
              "client-id-uri-scheme": [
                "https"
              ],
              "client-id-uri-allow-permitted-domains": [
                "claude.ai"
              ]
            }
          }
        ],
        "profiles": [
          "claude-cimd-profile"
        ]
      },
      {
        "name": "reject-confidential-claude-cimd",
        "description": "Reject confidential clients presented through Claude CIMD",
        "enabled": true,
        "mode": "STRICT",
        "conditions": [
          {
            "condition": "client-id-uri",
            "configuration": {
              "client-id-uri-scheme": [
                "https"
              ],
              "client-id-uri-allow-permitted-domains": [
                "claude.ai"
              ]
            }
          },
          {
            "condition": "client-access-type",
            "configuration": {
              "type": [
                "confidential"
              ]
            }
          }
        ],
        "profiles": [
          "reject-non-public-cimd-profile"
        ]
      },
      {
        "name": "reject-bearer-only-claude-cimd",
        "description": "Reject bearer-only clients presented through Claude CIMD",
        "enabled": true,
        "mode": "STRICT",
        "conditions": [
          {
            "condition": "client-id-uri",
            "configuration": {
              "client-id-uri-scheme": [
                "https"
              ],
              "client-id-uri-allow-permitted-domains": [
                "claude.ai"
              ]
            }
          },
          {
            "condition": "client-access-type",
            "configuration": {
              "type": [
                "bearer-only"
              ]
            }
          }
        ],
        "profiles": [
          "reject-non-public-cimd-profile"
        ]
      }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "OpenID Connect subject and authentication-time claims required by AIQT",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "OpenID Connect profile scope used by the AIQT Web login",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect email scope required by the AIQT tenant identity",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "aiqt:research:read",
      "description": "Read the authenticated user's AIQT research data through MCP",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read your AIQT research data"
      },
      "protocolMappers": [
        {
          "name": "aiqt-mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "${AIQT_PUBLIC_ORIGIN}/mcp",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
