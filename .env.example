# 共享 Web/桌面前端使用的本地 Python API。
VITE_QUANT_API_BASE=http://127.0.0.1:8765

# Stage 3 可选 AI Provider。留空时使用本地确定性研究助手。
OPENAI_API_KEY=
OPENAI_MODEL=

# OpenAI-compatible Base URL 必须包含 Provider API 前缀（例如 https://provider.example/v1），
# 但不能包含 /chat/completions；客户端按 rstrip("/") + "/chat/completions" 拼接请求路径。
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Docker 容器通过宿主机访问本地 Ollama；模型留空时不会启用该 Provider。
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# 交易所与生产授权初始值；首次网页保存后改由数据库配置实时接管。
CCXT_DEFAULT_EXCHANGE=binance
CCXT_TIMEOUT=10000
# 0 表示永久有效，直到手动暂停、急停或撤销授权。
AIQT_LIVE_SESSION_TTL_HOURS=8

# Stage 7 仅供 Binance Spot 生产只读准入。必须使用独立且关闭交易、提现和划转权限的 API Key；
# 不得复用 Sandbox、通用 CCXT 或未来生产下单凭据。留空时系统确定性 fail closed。
CCXT_PRODUCTION_READONLY_API_KEY=
CCXT_PRODUCTION_READONLY_SECRET=

# Stage 10 专用 Binance Spot 生产交易凭据。不得复用只读或 Sandbox Key；
# 仅在确认提现、内部划转、通用划转、Margin、Futures 与 Options 权限关闭后配置。
CCXT_PRODUCTION_TRADING_API_KEY=
CCXT_PRODUCTION_TRADING_SECRET=
# 只有完成 Stage 10 权限核验、恢复执行控制并在页面二次确认后才允许生产现货委托。
AIQT_ENABLE_PRODUCTION_TRADING=false
# M2 可选服务端告警 Webhook。留空时持久事件和浏览器提醒仍可用；
# 仅向该地址投递脱敏的事件开启/恢复消息，不提供任何交易命令入口。
AIQT_MONITORING_WEBHOOK_URL=
AIQT_MONITORING_WEBHOOK_TIMEOUT_SECONDS=5
# M3 可选 free-stockdb 本地只读比较源。仅发送固定的 A 股日 K GET 查询，
# 不调用同步、写入或计算命令，也不会把该地址返回浏览器。
AIQT_FREE_STOCKDB_URL=
AIQT_FREE_STOCKDB_TIMEOUT_SECONDS=3
# 容器需要代理访问 Binance 时设置为宿主机代理，例如 http://host.docker.internal:7890。
HTTPS_PROXY=

# 未来市场数据适配器使用的可选密钥。
ALPHA_VANTAGE_API_KEY=
# 可选的 URL-safe base64 AES-256 平台设置主密钥。
# 留空时 API 会在持久数据卷中创建 data/platform-settings.key。
AIQT_SETTINGS_MASTER_KEY=
